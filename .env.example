# MongoDB configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=attendance_db

# Flask configuration
FLASK_DEBUG=False
PORT=8000

# AI attendance tuning
# Leave AI_IGNORE_REGIONS empty unless you need to ignore a fixed observer area.
AI_IGNORE_REGIONS=
AI_MATCH_THRESHOLD=0.45
AI_PARTIAL_FACE_THRESHOLD=0.45
AI_MIN_MATCH_MARGIN=0.001
AI_MATCH_TOP_K=3
AI_MIN_HITS=2
AI_ALLOW_PARTIAL_MATCHES=0
AI_MAX_PROCESSED_FRAMES=140
AI_MAX_FACES_PER_FRAME=12
AI_DETECT_UPSCALE=1.40
AI_MIN_FACE_SCORE=0.25

# Local YOLO11 phone detection
PHONE_DETECTION_MODEL=models/phone_yolo11.pt
PHONE_DETECTION_FALLBACK_MODEL=models/yolo11s.pt
PHONE_DETECTION_MAX_FRAMES=60
PHONE_DETECTION_USE_TILES=1
PHONE_DETECTION_TILE_GRID=3x3
PHONE_DETECTION_CONFIDENCE=0.10
PHONE_DETECTION_FALLBACK_CONFIDENCE=0.35
PHONE_DETECTION_STRONG_CONFIDENCE=0.75
PHONE_DETECTION_MIN_SUPPORT_FRAMES=2
PHONE_DETECTION_FALLBACK_USE_TILES=0
PHONE_DETECTION_SEAT_ROWS=4
PHONE_DETECTION_SEAT_COLS=6
PHONE_DETECTION_IMGSZ=768
PHONE_DETECTION_CLASSES=phone,cell phone,mobile phone,smartphone,using phone,cellphone

# Local YOLO11 sleep detection
SLEEP_DETECTION_MODEL=models/sleep_yolo11.pt
SLEEP_DETECTION_MAX_FRAMES=20
SLEEP_DETECTION_USE_TILES=0
SLEEP_DETECTION_TILE_GRID=3x3
SLEEP_DETECTION_CONFIDENCE=0.85
SLEEP_DETECTION_STRONG_CONFIDENCE=0.90
SLEEP_DETECTION_MIN_SUPPORT_FRAMES=2
SLEEP_DETECTION_SEAT_ROWS=4
SLEEP_DETECTION_SEAT_COLS=6
SLEEP_DETECTION_IMGSZ=768
SLEEP_DETECTION_CLASSES=sleep,sleeping,sleeper,asleep,nap,napping,head down,heads down,lying down,laying down,prone,supine,to-left,to-right,to left,to right
