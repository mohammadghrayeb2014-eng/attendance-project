# MongoDB configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=attendance_db

# Flask configuration
FLASK_DEBUG=False
PORT=8000

# AI attendance tuning
# Leave AI_IGNORE_REGIONS empty unless you need to ignore a fixed observer area.
AI_IGNORE_REGIONS=
AI_MATCH_THRESHOLD=0.45
AI_PARTIAL_FACE_THRESHOLD=0.45
AI_MIN_MATCH_MARGIN=0.001
AI_MATCH_TOP_K=3
AI_MIN_HITS=2
AI_ALLOW_PARTIAL_MATCHES=0
AI_MAX_PROCESSED_FRAMES=140
AI_MAX_FACES_PER_FRAME=12
AI_DETECT_UPSCALE=1.40
AI_MIN_FACE_SCORE=0.25

# Roboflow phone detection workflow
ROBOFLOW_API_KEY=<your-roboflow-api-key>
ROBOFLOW_WORKFLOW_URL=https://detect.roboflow.com/infer/workflows/smart-classroom/detect-and-classify
ROBOFLOW_IMAGE_INPUT_NAME=image
PHONE_DETECTION_MAX_FRAMES=16
PHONE_DETECTION_CONFIDENCE=0.35
PHONE_DETECTION_CLASSES=phone,cell phone,mobile phone,smartphone
